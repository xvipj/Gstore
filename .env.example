# Application
APP_BASE_URL=http://localhost:8080
PORT=8080
DB_PATH=tienda.db

# Signed session cookie secret. Use a long random value outside the demo.
SESSION_SECRET=change-this-to-a-long-random-string-for-local-demo

# Demo admin. The first startup creates this user only if no admin exists.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Mercado Pago Checkout Pro (test credentials start with TEST-).
MP_ACCESS_TOKEN=

# Optional URL overrides. When empty, they are derived from APP_BASE_URL.
MP_NOTIFICATION_URL=
MP_SUCCESS_URL=
MP_PENDING_URL=
MP_FAILURE_URL=
